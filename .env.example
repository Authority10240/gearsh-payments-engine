# ──────────────────────────────────────────────────────────────────────────
# gearsh-payments-engine — environment template
# Copy to .env.local for development:  cp .env.example .env.local
# All secrets in production come from GCP Secret Manager (see ARCHITECTURE §8).
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8020
LOG_LEVEL=debug
SERVICE_NAME=gearsh-payments-engine

# ── Database ──────────────────────────────────────────────────────────────
# docker-compose maps Postgres to host port 5435 to avoid clashing with
# 5432 (local) / 5433 (auth) / 5434 (data). schema=public.
DATABASE_URL=postgresql://gearsh:local@localhost:5437/gearsh_payments?schema=public

# ── Redis (idempotency, FX cache) ────────────────────────────────────────
# docker-compose maps Redis to host port 6381.
REDIS_URL=redis://localhost:6381

# ── Platform JWT verification (RS256) ─────────────────────────────────────
# This engine VERIFIES tokens only; it does NOT issue them and holds no
# private key / JWKS. Provide the Auth Engine's public key (PEM, \n-escaped)
# OR a path.
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
JWT_ISSUER=gearsh-auth
JWT_AUDIENCE=gearsh-platform

# ── Internal service-to-service calls ─────────────────────────────────────
# Data Engine calls POST /v1/payment-intents with X-Internal-Service-Token.
AUTH_SERVICE_URL=http://localhost:8001
DATA_SERVICE_URL=http://localhost:8010
INTERNAL_JWT_AUDIENCE=gearsh-platform-internal
# Optional shared secret allowed in addition to a signed internal JWT.
INTERNAL_SERVICE_TOKEN=

# ── Business rules ────────────────────────────────────────────────────────
SERVICE_FEE_PERCENT=12.6
# Either party may open a dispute up to this many days after COMPLETED;
# payouts are dispatched only AFTER the window closes (business-rules §8.1).
DISPUTE_WINDOW_DAYS=7
# Minutes a LOCKED payment-intent stays valid before EXPIRY (§8.6).
FX_INTENT_LOCK_TTL_MINUTES=15

# ── PayFast ───────────────────────────────────────────────────────────────
# All blank → engine boots but PayFast calls return 503 PAYFAST_UPSTREAM_FAILURE
# until creds are provisioned (Secret Manager). PAYFAST_SANDBOX=true uses the
# sandbox URLs; flip to false in production.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
PAYFAST_RETURN_URL=https://payments.staging.thegearsh.app/return
PAYFAST_CANCEL_URL=https://payments.staging.thegearsh.app/cancel
PAYFAST_NOTIFY_URL=https://payments.staging.thegearsh.app/v1/webhooks/payfast
PAYFAST_REFUND_URL=https://api.payfast.co.za/refunds/{pf_payment_id}
PAYFAST_ADHOC_PAYMENT_URL=https://api.payfast.co.za/transactions/adhoc
# CSV of PayFast IPs allowed to call /v1/webhooks/payfast (per PayFast docs).
PAYFAST_IP_WHITELIST=197.97.145.144/28,41.74.179.192/27,102.216.36.64/29,102.216.36.128/29,144.126.193.139,196.33.227.224/29

# ── FX provider (Open Exchange Rates) ────────────────────────────────────
# Stub provider seeds rates from prisma/seeds/exchange-rates.ts when blank.
EXCHANGE_RATE_PROVIDER=open_exchange_rates
EXCHANGE_RATE_PROVIDER_URL=https://openexchangerates.org/api
EXCHANGE_RATE_PROVIDER_KEY=

# ── Payout-method encryption (pgcrypto) ──────────────────────────────────
# Symmetric key used to encrypt artist_payout_methods.account_number_encrypted.
# 32 bytes of high-entropy material in production; the placeholder boots dev
# but MUST be replaced via Secret Manager before staging.
PAYOUT_METHOD_ENCRYPTION_KEY=dev-payout-encryption-key-change-me

# ── Payout dispatcher / retry (PAY-005) ──────────────────────────────────
# Hourly cron picks up QUEUED payouts past dispatch_after; 4-hourly retry
# re-queues FAILED rows with backoff. Disable via _ENABLED=false in tests/dev.
PAYOUT_DISPATCH_ENABLED=true
PAYOUT_RETRY_ENABLED=true
# Stops the retry job once a payout has tried this many times
# (gearsh-payments-engine.md §Jobs: "5 attempts over 24h").
PAYOUT_MAX_ATTEMPTS=5
# Bounded batch per dispatcher tick — the next tick picks up the remainder.
PAYOUT_DISPATCH_BATCH_SIZE=50

# ── Reconciliation (PAY-007) ─────────────────────────────────────────────
# Nightly 02:30 SAST cron — disable via false in tests/CI so the scheduler
# doesn't race the e2e specs.
RECONCILIATION_ENABLED=true
# Threshold below which Σ ledger drift is logged but doesn't trigger an alert.
RECONCILIATION_ALERT_THRESHOLD_CENTS=1000
RECONCILIATION_ALERT_EMAIL=
# Stuck-state thresholds surfaced by /v1/admin/reconciliation/stuck/*.
STUCK_HOLD_HOURS=72
STUCK_PAYOUT_HOURS=24
STUCK_DISPUTE_DAYS=14

# ── Subscriber-driven actor (PAY-006) ────────────────────────────────────
# Subscribers (bookings.cancelled / disputes.resolved) call RefundsService.
# refunds.initiated_by is NOT NULL — the all-zeros UUID is the canonical
# "system" actor in dev/CI. Production overrides via Secret Manager with a
# real service-account UUID issued by the Auth Engine.
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000

# ── Pub/Sub ───────────────────────────────────────────────────────────────
PUBSUB_PROJECT_ID=
# Topics this engine PUBLISHES to (contracts/events/topics.md).
PUBSUB_PUBLISH_TOPICS=payment-events,escrow-events
# Subscriptions this engine CONSUMES from (contracts/events/topics.md).
PUBSUB_SUBSCRIPTIONS=payments-sub-booking-events,payments-sub-dispute-events
# Set to an emulator host (e.g. localhost:8085) to use the Pub/Sub emulator.
PUBSUB_EMULATOR_HOST=
# When unset, defaults to true when PUBSUB_PROJECT_ID is set. Set to false to
# log instead of publish + skip starting subscribers (handy locally).
PUBSUB_ENABLED=false

# ── CORS (admin web only; mobile uses direct HTTPS) ───────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_IP=300

# ── Observability ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local dev: PayFast's published sandbox credentials make /lock return a real
# signed sandbox form (merchant 10000100 / key 46f0cd694581a / passphrase
# jt7NOE43FZPn — public test values from the PayFast docs, safe to commit).
